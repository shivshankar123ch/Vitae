# Use test-mode credentials from your Razorpay dashboard while testing.
# Never commit your real key secret or share it in chat.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_secret

# Bootstrap credentials for managing the recruiter plan catalog.
# Replace both values with private credentials before starting the backend.
PLAN_ADMIN_USERNAME=plan-admin
PLAN_ADMIN_PASSWORD=replace-with-a-long-random-password
PLAN_ADMIN_JWT_SECRET=replace-with-a-separate-long-random-signing-secret

# Resend email OTP verification. Use an API key and verified sender address.
# Keep the API key private and server-side.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=Vitae <verify@your-verified-domain.com>
OTP_SESSION_SECRET=replace_with_a_separate_random_secret_at_least_32_characters
OTP_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
